  m_Script: {fileID: 11500000, guid: 2e2f0786f996745479cda7ef395a9b0a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ZT_CloudTutorial
  signLabel: {fileID: 642211031484036492}
  buildUnderCloudText: '[Cloud Tutorial 1/3]: This is a rain cloud. It always drifts
    along the same path, and its rain only falls on the ground beneath it. Watch
    where it goes, then build a Planting Bed under its path and sow a seed.'
  waitForRainText: '[Cloud Tutorial 2/3]:  Seed planted! Now wait for the cloud to
    pass over. If the soil never turns dark, your bed is outside the cloud''s path.
    Try building another one closer to where the rain falls.'
  growAndHarvestText: '[Cloud Tutorial 3/3]: The rain soaked your bed! See how the
    soil turned dark? Your flower grows whenever the soil is wet. Harvest 2 flowers
    in total to unlock the next part of the garden.'
  doneText: '[Cloud Tutorial] Complete! You have learned to garden with the clouds!
    The School is now open. Go there to train graduates, then use them to build Rain
    Machines that help you grow more flowers.'
