  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ZT_BuildTutorial
  signLabel: {fileID: 1959203371994525066}
  enterBuildText: '[Build Tutorial 1/3]: You can build now! Press A to enter build
    mode.'
  placeBedText: '[Build Tutorial 2/3]: Point at the ground. A green preview means
    you can build there, red means you can''t. Press B to switch between buildings,
    and pull the trigger to place a Planting Bed.'
  demolishText: '[Build Tutorial 3/3]: Nice work, your first Planting Bed! Placed
    something in the wrong spot? Point at the bed and press X on your left controller
    to remove it. You will get your resources back.'
  doneText: '[Build Tutorial] Complete! Head to the other table to start the Cloud
    Tutorial.'
