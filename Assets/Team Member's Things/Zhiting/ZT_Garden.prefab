  m_Script: {fileID: 11500000, guid: 795e4882655ba884ba452aae2e4e6ca0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ZT_RainMachineTutorial
  signLabel: {fileID: 642211031484036492}
  trainText: '[Rain Machine Tutorial 1/3]: Go to the School and train graduates.
    Every 3 graduates let you run 1 Rain Machine. Then come back and build it under
    the cloud''s path.'
  catchText: '[Rain Machine Tutorial 2/3]: Rain Machine built! Wait for the cloud
    to pass over it and watch the water level rise. If it never fills, demolish it
    and build it closer to the rain.'
  surroundText: '[Rain Machine Tutorial 3/3]: It caught the rain! A Rain Machine
    waters the four beds directly up, down, left and right of it. Build a Planting
    Bed on each side and sow them.'
  doneText: '[Garden Complete] Your Rain Machine is watering four beds on its own.
    You are now a Professor of Dream Flowers!'
