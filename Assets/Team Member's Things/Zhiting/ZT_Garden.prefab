  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ZT_TableTutorial
  signLabel: {fileID: 1959203371994525066}
  sowText: Tilt the seed jar to sow a seed into the planting bed.
  growText: Your seed has sprouted. Watch it grow.
  waterText: The flower has stopped growing. It needs water. Tilt the watering can
    over it.
  harvestText: The dream has bloomed. Touch it with the sickle to harvest. You will
    get a flower and some seeds.
  doneText: Well done. Now let's learn how to build.
